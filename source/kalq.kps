<Package>
  <System>
    <KeymanDeveloperVersion>18.0.254.0</KeymanDeveloperVersion>
    <FileVersion>7.0</FileVersion>
  </System>
  <Options>
    <ReadMeFile>readme.htm</ReadMeFile>
    <LicenseFile>..\LICENSE.md</LicenseFile>
    <WelcomeFile>welcome.htm</WelcomeFile>
    <FollowKeyboardVersion/>
  </Options>
  <Info>
    <Name URL="">KALQ</Name>
    <Copyright URL="">© Yash Bhargava</Copyright>
    <Author URL="">Yash Bhargava</Author>
    <Description URL="">KALQ split thumb layout with a permanent number row</Description>
  </Info>
  <Files>
